# Dependency lockfiles
**/package-lock.json
**/yarn.lock
**/pnpm-lock.yaml

# Dependencies and build output
**/node_modules/
**/dist/
**/target/
**/.astro/

# Scala build machinery
boot/
project/
**/*.class
**/*.tasty
**/*.jar

# Java RT extension (65MB jar)
java9-rt-ext-ubuntu*/

# Generated JS bundles (multi-MB Scala.js output)
engine/npm/main.js
client/npm/main.js
client/npm/client.js
cli/npm/
server/npm/bin/

# Source maps and compiled JS
**/*.js.map

# Licenses, changelogs, generic boilerplate
LICENSE
**/LICENSE
**/LICENSE.txt
CHANGELOG.md
**/CHANGELOG.md
changelog.md
**/changelog.md

# Editor/OS noise
.idea/
.vscode/
.DS_Store
**/.DS_Store

# Keep docs content, exclude build infrastructure
docs/dist/
docs/.astro/
docs/src/styles/
docs/astro.config.mjs
docs/tsconfig.json
docs/package.json

# Test files
**/src/test/
**/ts-test/
**/test/
**/tests/
**/__tests__/

# Large generated lock/config files in nested npm packages
knex/npm/package-lock.json

# Accidentally included reference documents
*.html
